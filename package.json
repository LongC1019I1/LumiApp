{
  "name": "electron-vue",
  "version": "0.17.1",
  "author": "tung1998 <tung16021220@gmail.com>",
  "description": "An electron-vue project",
  "license": null,
  "main": "./dist/electron/main.js",
  "scripts": {
    "build": "node .electron-vue/build.js && electron-builder",
    "build:dir": "node .electron-vue/build.js && electron-builder --dir",
    "build:clean": "cross-env BUILD_TARGET=clean node .electron-vue/build.js",
    "build:web": "cross-env BUILD_TARGET=web node .electron-vue/build.js",
    "dev": "cross-env APP_DEV=true node .electron-vue/dev-runner.js",
    "lint": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter src test",
    "lint:fix": "eslint --ext .js,.vue -f ./node_modules/eslint-friendly-formatter --fix src test",
    "pack": "npm run pack:main && npm run pack:renderer",
    "pack:main": "cross-env NODE_ENV=production webpack --progress --colors --config .electron-vue/webpack.main.config.js",
    "pack:renderer": "cross-env NODE_ENV=production webpack --progress --colors --config .electron-vue/webpack.renderer.config.js",
    "test": "npm run unit",
    "unit": "karma start test/unit/karma.conf.js",
    "postinstall": "npm run lint:fix"
  },
  "build": {
    "productName": "lumi-life",
    "appId": "com.example.yourapp",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/electron/**/*"
    ],
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.icns"
    },
    "win": {
      "icon": "build/icons/icon.ico"
    },
    "linux": {
      "icon": "build/icons"
    }
  },
  "dependencies": {
    "@sweetalert2/theme-bootstrap-4": "^3.2.0",
    "eslint-plugin-vue": "^6.2.2",
    "fecha": "^4.2.0",
    "ffmpeg-static": "^4.2.7",
    "hls.js": "^1.0.0-beta.3.0.canary.6697",
    "http-digest-client": "0.0.3",
    "needle": "^2.5.0",
    "npm": "^6.14.7",
    "promise.prototype.finally": "^3.1.2",
    "request-promise": "^4.2.6",
    "socket.io-client": "^2.3.0",
    "sweetalert2": "^9.17.1",
    "toastr": "^2.1.4",
    "vue": "^2.5.16",
    "vue-carousel": "^0.18.0",
    "vue-context": "^6.0.0",
    "vue-cookies": "^1.7.3",
    "vue-dragscroll": "^2.1.0",
    "vue-electron": "^1.0.6",
    "vue-flatpickr-component": "^8.1.5",
    "vue-fragment": "^1.5.1",
    "vue-horizontal-scroll": "^0.2.4",
    "vue-i18n": "^8.20.0",
    "vue-lazyload": "^1.3.3",
    "vue-pay-password": "0.0.4",
    "vue-router": "^3.0.1",
    "vue-scroll": "^2.1.13",
    "vue-select": "^3.10.8",
    "vue-sidebar-menu": "^4.7.1",
    "vue-slider-component": "^3.2.5",
    "vue-tel-input": "^4.4.0",
    "vue-text-mask": "^6.1.2",
